{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/employees"
    },
    {
      "source": "/employees",
      "destination": "/api/employees"
    }
  ],
  "functions": {
    "api/index.py": {
      "excludeFiles": "{ml/**,tests/**,docs/**,data/**,assets/**,public/**,app.py,build.py,Dockerfile,Makefile,requirements-dev.txt,requirements-training.txt,pyproject.toml,artifacts/**}"
    }
  }
}
